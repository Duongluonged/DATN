// =====================================================
// VietJob_DATN - Database Schema for dbdiagram.io
// Converted from scrip_vjt.sql (6/10/2026)
// =====================================================

Table NguoiDung {
  Id int [pk, increment]
  TenDangNhap nvarchar(100) [not null]
  MatKhau nvarchar(max) [not null]
  Email nvarchar(255) [not null]
  NgayTao datetime [default: `getdate()`]
  TrangThai nvarchar(20) [default: 'Pending']
  SoDienThoai varchar(20)
  DiaChi nvarchar(250)
  MaCongTy int
  SoDu int [not null, default: 5000000]
}

Table CongTy {
  MaCongTy int [pk, increment]
  TenCongTy nvarchar(255) [not null]
  DuongDanLogo nvarchar(500)
  MoTa nvarchar(max)
  DuongDanWebsite nvarchar(255)
  DiaDiem nvarchar(100)
  NoiBat bit [default: 0]
  NgayTao datetime [default: `getdate()`]
  NganhNghe nvarchar(255)
  QuyMo nvarchar(100)
  QuocGia nvarchar(100)
  ThoiGianLamViec nvarchar(255)
  LuongTrungBinh nvarchar(100)
  DanhGia decimal(2,1)
  SoLuongDanhGia int
  MoTaChiTiet nvarchar(max)
  DuongDayNong varchar(20)
  AnhVanPhong nvarchar(max)
}

Table CongViec {
  MaCongViec int [pk, increment]
  MaCongTy int
  TieuDeCongViec nvarchar(255) [not null]
  MucLuong nvarchar(100)
  LoaiCongViec nvarchar(50)
  KinhNghiem nvarchar(100)
  DiaDiem nvarchar(255)
  MoTa nvarchar(max)
  TrangThaiHoatDong bit [default: 1]
  NgayTao datetime [default: `getdate()`]
  KyNang nvarchar(max)
  CapBac nvarchar(100)
  GioiTinh nvarchar(50)
  HanNopHoSo datetime
  YeuCau nvarchar(max)
  QuyenLoi nvarchar(max)
  NoiBat bit [not null, default: 0]
}

Table HoSoUngVien {
  Id bigint [pk, increment, note: 'PK_UngVienBoilerplate']
  MaNguoiDung bigint [not null]
  HoTen nvarchar(256) [not null]
  TieuDe nvarchar(max)
  KyNang nvarchar(max)
  HocVan nvarchar(max)
  KinhNghiem nvarchar(max)
  DuongDanCv nvarchar(max)
  SoDienThoai nvarchar(max)
  ThoiGianTao datetime2 [not null]
  MaNguoiTao bigint
  ThoiGianCapNhatCuoi datetime2
  MaNguoiCapNhatCuoi bigint
  DaXoa bit [not null]
  MaNguoiXoa bigint
  ThoiGianXoa datetime2
}

Table DonUngTuyen {
  MaDonUngTuyen int [pk, increment]
  MaCongViec int [not null]
  TenUngVien nvarchar(255) [not null]
  SoDienThoai nvarchar(20)
  ThanhPho nvarchar(100)
  ThuGioiThieu nvarchar(max)
  DuongDanCv nvarchar(max)
  NgayNop datetime [default: `getdate()`]
  TrangThai nvarchar(50) [default: 'Dang cho duyet']
  MaNguoiDung int
  NgayPhongVan nvarchar(100)
  HinhThucPhongVan nvarchar(100)
  DiaDiemPhongVan nvarchar(500)
  GhiChuPhongVan nvarchar(max)
}

Table CvUngVien {
  Id int [pk, increment]
  MaNguoiDung int [not null, unique]
  GioiThieu nvarchar(max)
  KyNang nvarchar(max)
  NgayTao datetime [default: `getdate()`]
  DuongDanFileCv nvarchar(2000)
  TenFileCv nvarchar(500)
}

Table HocVanCv {
  Id int [pk, increment]
  MaCv int [not null]
  TenTruong nvarchar(255) [not null]
  ChuyenNganh nvarchar(255) [not null]
  NgayBatDau date
  NgayKetThuc date
}

Table KinhNghiemCv {
  Id int [pk, increment]
  MaCv int [not null]
  TenCongTy nvarchar(255) [not null]
  ViTri nvarchar(100) [not null]
  NgayBatDau date
  NgayKetThuc date
  MoTa nvarchar(max)
}

Table FileUngVien {
  Id int [pk, increment]
  MaNguoiDung int [not null]
  TenFile nvarchar(500) [not null]
  DuongDanFile nvarchar(2000) [not null]
  KichThuocFile int
  NgayTaiLen datetime [default: `getdate()`]
}

Table DanhGiaCongTy {
  Id int [pk, increment]
  MaCongTy int [not null]
  MaNguoiDung int
  DanhGia int [not null, note: 'CHECK: 1 <= DanhGia <= 5']
  TomTat nvarchar(500) [not null]
  ChinhSachTangCa nvarchar(50)
  LyDoTangCa nvarchar(1000)
  DiemYeuThich nvarchar(max)
  GopY nvarchar(max)
  NgayTao datetime [default: `getdate()`]
}

Table BaoCaoCongViec {
  MaBaoCao int [pk, increment]
  MaCongViec int [not null]
  MaNguoiDung int
  LyDo nvarchar(255) [not null]
  MoTa nvarchar(max)
  TrangThai nvarchar(50) [default: 'Pending']
  NgayTao datetime [default: `getdate()`]
}

Table KyNang {
  MaKyNang int [pk, increment]
  TenKyNang nvarchar(50) [not null, unique]
}

Table KyNangCongViec {
  MaCongViec int [not null]
  MaKyNang int [not null]

  indexes {
    (MaCongViec, MaKyNang) [pk]
  }
}

Table TinNhan {
  MaTinNhan int [pk, increment]
  MaNguoiGui int [not null]
  MaNguoiNhan int [not null]
  NoiDungTinNhan nvarchar(max) [not null]
  NgayTao datetime [default: `getdate()`]
  DaDoc bit [default: 0]
  DuongDanDinhKem nvarchar(max)
  TenFileDinhKem nvarchar(255)
}

Table ThongBao {
  MaThongBao int [pk, increment]
  MaNguoiDung int [not null]
  LoaiThongBao nvarchar(50) [not null, default: 'system']
  TieuDe nvarchar(255) [not null]
  NoiDung nvarchar(max) [not null]
  DaDoc bit [not null, default: 0]
  NgayTao datetime [default: `getdate()`]
  MaLienQuan int
}

Table TuKhoaPhoBien {
  MaTuKhoa int [pk, increment]
  TenTuKhoa nvarchar(100) [not null]
  SoLuotTimKiem int [default: 0]
}

Table GiaoDich {
  Id int [pk, increment]
  MaNguoiDung int [not null]
  TieuDe nvarchar(255) [not null]
  SoTien int [not null]
  LoaiGiaoDich nvarchar(50) [not null]
  TrangThai nvarchar(50) [not null]
  NgayTao datetime [default: `getdate()`]
  MaThamChieu nvarchar(100)
}

Table KhoaHoc {
  Id int [pk, increment, note: 'PK_KhoaHoc']
  MaNhaTuyenDung int [not null]
  TieuDe nvarchar(max)
  MoTa nvarchar(max)
  TrangThai nvarchar(max)
  ThoiGianTao datetime2 [not null]
  MaNguoiTao bigint
  ThoiGianCapNhat datetime2
  MaNguoiCapNhat bigint
  DaXoa bit [not null]
  MaNguoiXoa bigint
  ThoiGianXoa datetime2
  DanhMuc nvarchar(50) [default: 'web']
  DanhGia decimal(2,1) [default: 4.8]
  SoLuongDanhGia int [default: 24]
  ThoiLuong nvarchar(50) [default: '45 gio']
  SoBaiHoc int [default: 50]
  TrinhDo nvarchar(50) [default: 'Moi trinh do']
  TenGiangVien nvarchar(100)
  VaiTroGiangVien nvarchar(150)
  Gia int [default: 1500000]
  GiaCu int [default: 3000000]
  DuongDanDrive nvarchar(500)
}

Table DangKiKhoahoc {
  MaKhoaHocNguoiDung int [pk, increment]
  MaNguoiDung int [not null]
  MaKhoaHoc nvarchar(100) [not null]
  TrangThai nvarchar(50) [not null, default: 'Dang quan tam']
  NgayTao datetime [default: `getdate()`]
  CapNhatLanCuoi datetime [default: `getdate()`]
}

Table VaiTro {
  MaVaiTro int [pk, increment]
  TenVaiTro nvarchar(50) [not null, unique]
}

Table VaiTroNguoiDung {
  MaNguoiDung int [not null]
  MaVaiTro int [not null]

  indexes {
    (MaNguoiDung, MaVaiTro) [pk]
  }
}

// =====================================================
// RELATIONSHIPS / FOREIGN KEYS
// =====================================================

// NguoiDung -> CongTy
Ref: NguoiDung.MaCongTy > CongTy.MaCongTy

// HoSoUngVien -> NguoiDung
Ref: HoSoUngVien.MaNguoiDung > NguoiDung.Id

// DonUngTuyen -> CongViec
Ref: DonUngTuyen.MaCongViec > CongViec.MaCongViec

// DonUngTuyen -> NguoiDung
Ref: DonUngTuyen.MaNguoiDung > NguoiDung.Id

// CvUngVien -> NguoiDung
Ref: CvUngVien.MaNguoiDung > NguoiDung.Id [delete: cascade]

// HocVanCv -> CvUngVien
Ref: HocVanCv.MaCv > CvUngVien.Id [delete: cascade]

// KinhNghiemCv -> CvUngVien
Ref: KinhNghiemCv.MaCv > CvUngVien.Id [delete: cascade]

// FileUngVien -> NguoiDung
Ref: FileUngVien.MaNguoiDung > NguoiDung.Id

// DanhGiaCongTy -> CongTy
Ref: DanhGiaCongTy.MaCongTy > CongTy.MaCongTy

// DanhGiaCongTy -> NguoiDung
Ref: DanhGiaCongTy.MaNguoiDung > NguoiDung.Id

// BaoCaoCongViec -> CongViec
Ref: BaoCaoCongViec.MaCongViec > CongViec.MaCongViec

// BaoCaoCongViec -> NguoiDung
Ref: BaoCaoCongViec.MaNguoiDung > NguoiDung.Id

// CongViec -> CongTy
Ref: CongViec.MaCongTy > CongTy.MaCongTy

// KyNangCongViec -> CongViec
Ref: KyNangCongViec.MaCongViec > CongViec.MaCongViec

// KyNangCongViec -> KyNang
Ref: KyNangCongViec.MaKyNang > KyNang.MaKyNang

// GiaoDich -> NguoiDung
Ref: GiaoDich.MaNguoiDung > NguoiDung.Id

// KhoaHoc -> NguoiDung (nha tuyen dung tao khoa hoc)
Ref: KhoaHoc.MaNhaTuyenDung > NguoiDung.Id

// DangKiKhoahoc -> NguoiDung
Ref: DangKiKhoahoc.MaNguoiDung > NguoiDung.Id

// TinNhan -> NguoiDung (nguoi nhan)
Ref: TinNhan.MaNguoiNhan > NguoiDung.Id

// TinNhan -> NguoiDung (nguoi gui)
Ref: TinNhan.MaNguoiGui > NguoiDung.Id

// ThongBao -> NguoiDung
Ref: ThongBao.MaNguoiDung > NguoiDung.Id

// VaiTroNguoiDung -> VaiTro (FK_Role)
Ref: VaiTroNguoiDung.MaVaiTro > VaiTro.MaVaiTro

// VaiTroNguoiDung -> NguoiDung (FK_User)
Ref: VaiTroNguoiDung.MaNguoiDung > NguoiDung.Id
