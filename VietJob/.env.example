# ============================================================
# FIREBASE (Google Login)
# Lấy từ: https://console.firebase.google.com
#   → Project Settings → General → Your apps → Web app
# ============================================================
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ============================================================
# LINKEDIN OAuth 2.0
# Lấy từ: https://www.linkedin.com/developers/apps
#   → Tạo app → OAuth 2.0 → Client ID & Client Secret
#   → Thêm Redirect URL: http://localhost:5173/auth/linkedin/callback
# ============================================================
VITE_LINKEDIN_CLIENT_ID=YOUR_LINKEDIN_CLIENT_ID
VITE_LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback
